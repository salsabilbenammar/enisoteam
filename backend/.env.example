PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eniso_team
JWT_SECRET=changez_moi_en_production_secret_tres_long
JWT_EXPIRES_IN=365d
# Origine(s) du site (CORS + liens e-mail). Une seule URL publique en prod.
# Plusieurs origines possibles en séparant par des virgules (CORS seulement).
FRONTEND_URL=http://localhost:5173
# Servir frontend/dist depuis Express (true par défaut si dist/ existe)
# SERVE_FRONTEND=true

# SMTP (Nodemailer) — laisser vide pour simuler l'envoi en console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ENISO Team <noreply@enisoteam.local>"

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optionnel : URL complète (sinon construite depuis SPREADSHEET_ID)
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_RANGE=Candidats!A:L
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
# Méthode recommandée (Apps Script webhook)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
